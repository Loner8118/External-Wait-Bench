# Server
PORT=5000
DEBUG=false

# Redis
REDIS_URL=redis://redis:6379/0

# Delivery Configuration
DELIVERY_MODE=parallel
REQUEST_TIMEOUT_MS=2000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=100
IDEMPOTENCY_TTL_SECONDS=3600

# Target URLs (Docker internal)
TARGET_A_URL=http://target-a:5000
TARGET_B_URL=http://target-b:5000
TARGET_C_URL=http://target-c:5000
TARGET_D_URL=http://target-d:5000

# Mock Service Configuration (per-target, set in docker-compose.yml)
# TARGET_A_LATENCY_MS=100
# TARGET_A_ERROR_RATE=0.01
# TARGET_A_TIMEOUT_RATE=0.0
# ... etc.
